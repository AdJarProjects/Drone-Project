# systemd unit to auto-start the maze drone controller on boot.
# Install:
#   sudo cp drone.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now drone.service
# Logs:  journalctl -u drone.service -f
#
# SAFETY: only enable this once link, control, arming and failsafe are
# fully tested props-off. Auto-start means it runs the moment the Pi boots.

[Unit]
Description=Autonomous Maze Drone Controller
After=multi-user.target

[Service]
Type=simple
User=adamj
WorkingDirectory=/home/adamj/drone_maze
# Point this at your venv python if you used one:
ExecStart=/home/adamj/drone_maze/venv/bin/python /home/adamj/drone_maze/main.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
